# SEPolicy rules for Sound_And_Emoji_IOS
# Allow audioserver and mediaserver to read module-mounted files
# Allow system_server to perform bind mounts in /data/data/

# Allow mediaserver to read system audio files with our custom context
allow mediaserver system_file:file { read open getattr };
allow mediaserver system_file:dir { search read open getattr };
allow audioserver system_file:file { read open getattr };
allow audioserver system_file:dir { search read open getattr };

# Allow untrusted apps (Facebook/Messenger) to read bind-mounted emoji fonts
allow untrusted_app system_file:file { read open getattr map };
allow untrusted_app system_file:dir { search read open getattr };
allow untrusted_app_32 system_file:file { read open getattr map };
allow untrusted_app_32 system_file:dir { search read open getattr };

# Allow platform apps (Gboard) to read system emoji fonts
allow platform_app system_file:file { read open getattr map };
allow platform_app system_file:dir { search read open getattr };
allow gmscore_app system_file:file { read open getattr map };
allow gmscore_app system_file:dir { search read open getattr };

# Allow privileged apps (Samsung/Xiaomi/OEM system apps) to read emoji fonts
allow priv_app system_file:file { read open getattr map };
allow priv_app system_file:dir { search read open getattr };

# Allow isolated apps (WebView renderers) to read emoji fonts for correct display
allow isolated_app system_file:file { read open getattr map };

# Allow system_server to read/write app_data_file for emoji font operations
allow system_server app_data_file:file { read write open getattr setattr };
allow system_server app_data_file:dir { search read open getattr };
